# disk.py configuration — copy this file to `.env` and edit it.
#
# The script reads `.env` from its own directory. A real environment variable of
# the same name overrides the file, so you can also do e.g.:
#     QBT_PASS='secret' python3 disk.py /mnt/pool
# Point at a different file with the DISK_ENV environment variable.
#
# List values accept a JSON array (best when paths contain spaces or odd
# characters) OR a plain comma-separated string. Object values are JSON.

# ── qBittorrent (optional; leave blank to skip torrent classification) ──
QBT_URL=
QBT_USER=
QBT_PASS=

# Extra qBittorrent instances, all merged into one pool. JSON array of objects:
#   [{"url":"https://seedbox:8080","user":"admin","pass":"","insecure":true}]
QBT_INSTANCES=[]

# Media library folder(s). Files here get protective "used" reclassification.
# On a mergerfs union, list the media path on each branch, e.g.:
#   MEDIA_DIRS=["/mnt/disk1/Media","/mnt/disk2/Media"]
MEDIA_DIRS=[]

# Map on-disk path prefixes to the prefixes qBittorrent reports (Docker bind
# mounts, mergerfs/union mounts). JSON object, e.g.:
#   PATH_MAPPINGS={"/mnt/disk1":"/mnt/pool","/mnt/disk2":"/mnt/pool"}
# Auto-derived when you scan a mergerfs union, so usually leave as {}.
PATH_MAPPINGS={}

# Extensions to skip during the scan (comma-separated, no dots). Handy to skip
# metadata and the tool's own outputs, e.g.: nfo,txt,srt,jpg,log,html,json,db
IGNORE_EXT=

# ── Advanced (optional; sensible defaults, rarely changed) ──
# Which qBittorrent states count as "active" (comma-separated).
# ACTIVE_TORRENT_STATES=uploading,stalledUP,forcedUP,checkingUP,queuedUP,downloading,stalledDL,forcedDL,checkingDL,queuedDL,moving,allocating,metaDL,forcedMetaDL
# PARTIAL_BYTES=8192          # head+tail bytes read for the quick duplicate filter
# READ_CHUNK=131072           # bytes per read() during full hashing
# REPORT_WIDTH=90             # terminal report width
#
# (Media-type categories by extension are defined in disk.py's MEDIA_TYPES.)
